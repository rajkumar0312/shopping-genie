# SerpApi (preferred MVP real-data source)
# Create a SerpApi account and put the private key in your local .env only.
SERPAPI_API_KEY=

# Flipkart Affiliate API (optional; only used if valid credentials are available)
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# Backend
PORT=8081
HOST=0.0.0.0
